# dependencies
node_modules/

# local snapshots produced by tools/restore.mjs
backup/

# build output
dist/
*.zip

# runtime diagnostics
diag.log

# v0.5.0 host-side state: settings file, pre-crop cache, derived transcodes.
# These are per-machine runtime data, never committed.
state/
assets/derived/

# local Wallpaper Engine roots (per-machine paths)
we-roots.json

# wallpaper / companion media: ship the three defaults in the full repo, ignore
# uploads and any other user-supplied media.
assets/*
!assets/README.md
!assets/bg-main.mp4
!assets/bg-4k.mp4
!assets/cat.png

# editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/
