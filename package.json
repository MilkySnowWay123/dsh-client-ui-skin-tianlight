{
  "name": "dsh-client-ui-skin-tianlight",
  "description": "Tianlight skin for the dsh web GUI: Makoto Shinkai daylight skies, an 18.5s cinematic opening film / compact splash, a looping video wallpaper, a wallpaper library with upload/rotation, optional WebWallGL scene support, and a draggable Mint chibi-cat desktop companion",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-client-ui-skin-tianlight": "bin/cli.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./skin.json": "./skin.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "skin",
    "theme",
    "wallpaper",
    "anime",
    "shinkai"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "build:check": "node tools/build.mjs --check",
    "check": "node tools/build.mjs --check && node tools/test.mjs && node tools/structure.mjs --strict && node tools/audit.mjs && node tools/check-css.mjs && node tools/verify.mjs && node tools/i18n-audit.mjs",
    "upgrade": "node tools/upgrade-check.mjs && node tools/hook-scan.mjs --self-check",
    "hook-scan": "node tools/hook-scan.mjs",
    "compat": "node tools/compat-matrix.mjs",
    "pack": "node tools/pack.mjs",
    "artifacts": "node tools/release-artifacts.mjs",
    "verify-install": "node tools/verify-install.mjs",
    "snapshot": "node tools/snapshot.mjs",
    "restore": "node tools/restore.mjs",
    "agent-check": "node tools/agent-check.mjs",
    "release": "node tools/release.mjs",
    "i18n-audit": "node tools/i18n-audit.mjs",
    "npm:publish": "node tools/npm-publish.mjs",
    "npm:publish:dry": "node tools/npm-publish.mjs --dry-run"
  },
  "files": [
    "bin",
    "lib",
    "vendor",
    "assets",
    "presets",
    "cordis.patch.yml",
    "docs/THIRD-PARTY.md",
    "skin.json",
    "build-info.json",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MilkySnowWay123/dsh-client-ui-skin-tianlight.git"
  },
  "homepage": "https://github.com/MilkySnowWay123/dsh-client-ui-skin-tianlight#readme",
  "bugs": {
    "url": "https://github.com/MilkySnowWay123/dsh-client-ui-skin-tianlight/issues"
  }
}
